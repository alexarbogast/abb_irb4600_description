  This file originated from `irb4600_40_255.xacro` in the
  ros_industrial/abb_experimental repository.
  (https://github.com/ros-industrial/abb_experimental)

  Modifications have been made to add a prefix argument and to attach the base
  of the robot to a world frame.
-->
<robot name="abb_irb4600_40_255" xmlns:xacro="http://ros.org/wiki/xacro">
  <xacro:arg name="prefix" default=""/>
  <xacro:arg name="use_mock_hardware" default="true"/>
  <xacro:arg name="include_hardware" default="true"/>
  <xacro:arg name="use_fake_hardware" default="true"/>
  <xacro:arg name="rws_ip" default="None"/>
  <xacro:arg name="rws_port" default="80"/>
  <xacro:arg name="configure_via_rws" default="true"/>
  <xacro:arg name="initial_positions_file"
    default="$(find abb_irb4600_description)/config/initial_positions.yaml"/>
  <xacro:arg name="joint_limits_file"
    default="$(find abb_irb4600_description)/config/joint_limits.yaml"/>

  <xacro:include filename="$(find abb_irb4600_description)/urdf/abb_irb4600_40_255_macro.xacro"/>
  <xacro:abb_irb4600_40_255 prefix="$(arg prefix)"
    joint_limits_file="$(arg joint_limits_file)"/>

  <!-- 'world' frame - default pose reference frame -->
  <link name="world" />
  <joint name="world-$(arg prefix)base_link" type="fixed">
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <parent link="world"/>
    <child link="$(arg prefix)base_link"/>
  </joint>

  <xacro:if value="$(arg include_hardware)">
    <xacro:include
      filename="$(find abb_irb4600_description)/urdf/abb_irb4600_40_255.ros2_control.xacro"/>
    <xacro:abb_irb4600_ros2_control prefix="$(arg prefix)"
      use_mock_hardware="$(arg use_mock_hardware)"
      initial_positions_file="$(arg initial_positions_file)"
      joint_limits_file="$(arg joint_limits_file)"
      rws_ip="$(arg rws_ip)"
      rws_port="$(arg rws_port)"
      configure_via_rws="$(arg configure_via_rws)"/>

  </xacro:if>
</robot>
